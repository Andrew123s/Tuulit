---
import Base from "../layouts/Base.astro";

interface Props {
  title: string;
  description: string;
  path: string;
  intro: string;
  meta?: string[];
  toc: { id: string; label: string }[];
}
const { title, description, path, intro, meta = [], toc } = Astro.props;
---
<Base title={title} description={description} path={path}>
  <div class="wrap doc">
    <header class="doc-head">
      <p class="overline">Tuulit</p>
      <h1>{title}</h1>
      <p class="lead" style="margin-top:16px;max-width:60ch">{intro}</p>
      {meta.length > 0 && <div class="doc-meta">{meta.map((m) => <span class="chip">{m}</span>)}</div>}
    </header>
    <div class="doc-layout">
      <nav class="toc" aria-label="On this page">
        <p class="overline" style="margin:0 0 8px 12px">On this page</p>
        <ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}</ol>
      </nav>
      <article class="prose"><slot /></article>
    </div>
  </div>
</Base>
