---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
const topics = ["General enquiry", "Technical support", "Privacy enquiry", "Data deletion", "Feedback"];
const cards = [
  { t: "General enquiries", d: "Questions about Tuulit, partnerships or press.", tint: "var(--peach-soft)" },
  { t: "Technical support", d: "Something not working? Tell us your phone model and what happened.", tint: "var(--lilac-soft)" },
  { t: "Privacy enquiries", d: "Questions about your data or your rights under the GDPR.", tint: "var(--rose-soft)" },
  { t: "Data deletion", d: "Delete your account in the app, or ask us if you can't.", tint: "var(--banana-soft)", href: "/account-deletion" },
];
---
<Base title="Contact and support" description="Contact Tuulit for support, privacy enquiries, data deletion requests or feedback." path="/contact">
  <div class="wrap doc">
    <header class="doc-head">
      <p class="overline">We're here to help</p>
      <h1>Contact and support</h1>
      <p class="lead" style="margin-top:16px">Send us a message below or email <a href={`mailto:${site.email}`}>{site.email}</a>. We read every message.</p>
    </header>

    <div class="contact-grid">
      <div class="cards">
        {cards.map((c) => (
          <div class="ccard" style={`background:${c.tint}`}>
            <h2>{c.t}</h2>
            <p class="muted">{c.d}</p>
            {c.href && <a href={c.href}>How account deletion works</a>}
          </div>
        ))}
        <p class="muted small">Please don't send medical emergencies here. If you need urgent help, contact your local emergency number.</p>
      </div>

      <form class="form" id="contact-form" novalidate>
        <div class="field">
          <label for="name">Your name</label>
          <input id="name" name="name" autocomplete="name" maxlength="80" required />
        </div>
        <div class="field">
          <label for="email">Email address</label>
          <input id="email" name="email" type="email" autocomplete="email" maxlength="254" required />
        </div>
        <div class="field">
          <label for="topic">Topic</label>
          <select id="topic" name="topic" required>
            <option value="">Choose a topic</option>
            {topics.map((t) => <option value={t}>{t}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="6" minlength="10" maxlength="4000" required></textarea>
        </div>
        <div class="hp" aria-hidden="true">
          <label for="website">Leave this field empty</label>
          <input id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <p class="muted small">We use your details only to reply. See our <a href="/privacy">Privacy Policy</a>.</p>
        <p class="status" id="status" role="status" aria-live="polite"></p>
        <button class="btn btn-ink" type="submit" id="send">Send message</button>
        <noscript><p class="muted small">This form needs JavaScript. You can email <a href={`mailto:${site.email}`}>{site.email}</a> instead.</p></noscript>
      </form>
    </div>
  </div>
</Base>

<script define:vars={{ endpoint: site.contactEndpoint, email: site.email }}>
  const form = document.getElementById("contact-form");
  const status = document.getElementById("status");
  const send = document.getElementById("send");
  const startedAt = Date.now();
  const show = (msg, kind) => { status.textContent = msg; status.dataset.kind = kind; };
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form));
    const fields = ["name", "email", "topic", "message"];
    for (const f of fields) form.elements[f].removeAttribute("aria-invalid");
    const bad = fields.find((f) => !form.elements[f].checkValidity());
    if (bad) {
      form.elements[bad].setAttribute("aria-invalid", "true");
      form.elements[bad].focus();
      show({ name: "Please tell us your name.", email: "Please enter a valid email address.", topic: "Please choose a topic.", message: "Please write at least 10 characters." }[bad], "error");
      return;
    }
    send.disabled = true; send.textContent = "Sending…"; show("", "");
    try {
      const res = await fetch(endpoint, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ ...data, startedAt }) });
      const body = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(body.error || "Something went wrong.");
      form.reset();
      show("Thank you. Your message is on its way, and we'll reply by email.", "ok");
    } catch (err) {
      show(`${err.message} You can also email ${email}.`, "error");
    } finally {
      send.disabled = false; send.textContent = "Send message";
    }
  });
</script>

<style>
  .contact-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(24px, 5vw, 56px); align-items: start; }
  .cards { display: grid; gap: 14px; }
  .ccard { padding: 22px 24px; border-radius: var(--r-lg); }
  .ccard h2 { font-size: 1.35rem; margin-bottom: 6px; }
  .small { font-size: 0.9rem; }
  .form { background: var(--oat); border-radius: var(--r-xl); padding: clamp(22px, 4vw, 40px); display: grid; gap: 18px; box-shadow: var(--shadow); }
  .field { display: grid; gap: 6px; }
  label { font-weight: 700; font-size: 0.95rem; }
  input, select, textarea { font: inherit; color: var(--ink); background: var(--sand); border: 2px solid transparent; border-radius: 14px; padding: 13px 16px; min-height: 52px; width: 100%; }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--ink); }
  [aria-invalid="true"] { border-color: var(--coral-deep); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .status:empty { display: none; }
  .status { padding: 12px 16px; border-radius: 14px; font-weight: 600; }
  .status[data-kind="ok"] { background: var(--lilac-soft); }
  .status[data-kind="error"] { background: var(--coral-soft); }
  .form .btn { justify-self: start; }
  .form .btn:disabled { opacity: .6; cursor: wait; }
  @media (max-width: 860px) { .contact-grid { grid-template-columns: 1fr; } }
</style>
